text = "module HelloWorld {
	class Program {
		static method ThrowExample() -> void{
			ldstr \"no scene named Cat.tscn\"
			call GodotExceptions.InvalidSceneException(string)
		}
	
		static method Main() -> void {
			local Item: object
			ldstr \"hello world me\"
			call GD.Print(string)
			try {
				call Program.ThrowExample() -> void
			}
			catch {
				ldstr \"something broke\"
				call GD.Print(string string) -> void
			}
	}
}"
